{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"types": ["@valenced/types"]
	},
	"include": ["plugins", "themes", "shared"],
	"exclude": ["plugins/*/build", "themes/*/build"]
}
